diff --git a/native/ascendc/leapquant_state_codec/host/leapquant_all_head_runtime_probe.cpp b/native/ascendc/leapquant_state_codec/host/leapquant_all_head_runtime_probe.cpp
new file mode 100644
index 000000000..3b1722a81
--- /dev/null
+++ b/native/ascendc/leapquant_state_codec/host/leapquant_all_head_runtime_probe.cpp
@@ -0,0 +1,420 @@
+#include <acl/acl.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "statecentric/leapquant_state_codec_kernel.h"
+
+namespace {
+
+constexpr std::size_t kHeads = 576;
+constexpr std::size_t kKeys = 128;
+constexpr std::size_t kValues = 128;
+constexpr std::size_t kRank = 4;
+constexpr std::size_t kElementsPerHead = kKeys * kValues;
+constexpr std::size_t kCompensatorsPerHead = kKeys * kRank;
+constexpr std::size_t kGuardBytes = 256;
+
+void Check(aclError status, const char* operation) {
+  if (status != ACL_SUCCESS) {
+    throw std::runtime_error(std::string(operation) + " failed: " +
+                             std::to_string(status));
+  }
+}
+
+double Median(std::vector<double> values) {
+  std::sort(values.begin(), values.end());
+  return values[values.size() / 2];
+}
+
+template <class Type>
+class DeviceBuffer {
+ public:
+  explicit DeviceBuffer(std::size_t elements)
+      : elements_(elements), payload_bytes_(elements * sizeof(Type)) {
+    Check(aclrtMalloc(reinterpret_cast<void**>(&data_),
+                      payload_bytes_ + kGuardBytes,
+                      ACL_MEM_MALLOC_HUGE_FIRST),
+          "aclrtMalloc");
+    Check(aclrtMemset(data_, payload_bytes_ + kGuardBytes, 0x5a,
+                      payload_bytes_ + kGuardBytes),
+          "aclrtMemset guard");
+  }
+  ~DeviceBuffer() {
+    if (data_ != nullptr) (void)aclrtFree(data_);
+  }
+  DeviceBuffer(const DeviceBuffer&) = delete;
+  DeviceBuffer& operator=(const DeviceBuffer&) = delete;
+  Type* data() const { return data_; }
+  std::size_t bytes() const { return payload_bytes_; }
+  void CheckGuard() const {
+    std::vector<std::uint8_t> guard(kGuardBytes);
+    const auto* source = reinterpret_cast<const std::uint8_t*>(data_) +
+                         payload_bytes_;
+    Check(aclrtMemcpy(guard.data(), guard.size(), source, guard.size(),
+                      ACL_MEMCPY_DEVICE_TO_HOST),
+          "aclrtMemcpy guard");
+    if (!std::all_of(guard.begin(), guard.end(),
+                     [](std::uint8_t value) { return value == 0x5a; })) {
+      throw std::runtime_error("device guard changed");
+    }
+  }
+
+ private:
+  Type* data_ = nullptr;
+  std::size_t elements_ = 0;
+  std::size_t payload_bytes_ = 0;
+};
+
+template <class Type>
+void ToDevice(DeviceBuffer<Type>& destination,
+              const std::vector<Type>& source) {
+  if (destination.bytes() != source.size() * sizeof(Type)) {
+    throw std::runtime_error("H2D geometry differs");
+  }
+  Check(aclrtMemcpy(destination.data(), destination.bytes(), source.data(),
+                    destination.bytes(), ACL_MEMCPY_HOST_TO_DEVICE),
+        "aclrtMemcpy H2D");
+}
+
+template <class Type>
+std::vector<Type> FromDevice(const DeviceBuffer<Type>& source,
+                             std::size_t elements) {
+  std::vector<Type> output(elements);
+  Check(aclrtMemcpy(output.data(), output.size() * sizeof(Type), source.data(),
+                    source.bytes(), ACL_MEMCPY_DEVICE_TO_HOST),
+        "aclrtMemcpy D2H");
+  return output;
+}
+
+template <class Launch>
+double Measure(aclrtStream stream, Launch&& launch) {
+  Check(aclrtSynchronizeStream(stream), "sync before measure");
+  const auto begin = std::chrono::steady_clock::now();
+  launch();
+  Check(aclrtSynchronizeStream(stream), "sync after measure");
+  return std::chrono::duration<double, std::micro>(
+             std::chrono::steady_clock::now() - begin)
+      .count();
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  bool initialized = false;
+  bool device_set = false;
+  int device = -1;
+  aclrtStream stream = nullptr;
+  try {
+    if (argc != 2) throw std::invalid_argument("usage: probe DEVICE");
+    device = std::stoi(argv[1]);
+    Check(aclInit(nullptr), "aclInit");
+    initialized = true;
+    Check(aclrtSetDevice(device), "aclrtSetDevice");
+    device_set = true;
+    Check(aclrtCreateStream(&stream), "aclrtCreateStream");
+
+    constexpr std::size_t kElements = kHeads * kElementsPerHead;
+    constexpr std::size_t kVectors = kHeads * kKeys;
+    constexpr std::size_t kCompensators =
+        kHeads * kCompensatorsPerHead;
+    std::vector<float> residual(kElements);
+    std::vector<float> compensator_keys(kCompensators);
+    std::vector<float> compensator_values(kCompensators);
+    for (std::size_t head = 0; head < kHeads; ++head) {
+      for (std::size_t index = 0; index < kElementsPerHead; ++index) {
+        const auto integer = static_cast<int>(
+            (index * 17 + head * 13 + 11) % 257);
+        float value = static_cast<float>(integer - 128) / 256.0F;
+        if ((index + head * 7) % 521 == 0) value += 2.0F;
+        residual[head * kElementsPerHead + index] = value;
+      }
+      for (std::size_t index = 0; index < kCompensatorsPerHead; ++index) {
+        const auto key_integer = static_cast<int>(
+            (index * 19 + head * 5 + 3) % 97);
+        const auto value_integer = static_cast<int>(
+            (index * 23 + head * 7 + 1) % 89);
+        compensator_keys[head * kCompensatorsPerHead + index] =
+            static_cast<float>(key_integer - 48) / 2048.0F;
+        compensator_values[head * kCompensatorsPerHead + index] =
+            static_cast<float>(value_integer - 44) / 2048.0F;
+      }
+    }
+
+    DeviceBuffer<float> residual_device(kElements);
+    DeviceBuffer<float> raw_copy_device(kElements);
+    DeviceBuffer<std::int8_t> quantized_device(kElements);
+    DeviceBuffer<float> smoothing_device(kVectors);
+    DeviceBuffer<float> scales_device(kVectors);
+    DeviceBuffer<float> keys_device(kCompensators);
+    DeviceBuffer<float> values_device(kCompensators);
+    DeviceBuffer<float> dense_device(kElements);
+    DeviceBuffer<std::int8_t> quantized_copy(kElements);
+    DeviceBuffer<float> smoothing_copy(kVectors);
+    DeviceBuffer<float> scales_copy(kVectors);
+    DeviceBuffer<float> keys_copy(kCompensators);
+    DeviceBuffer<float> values_copy(kCompensators);
+    ToDevice(residual_device, residual);
+    ToDevice(keys_device, compensator_keys);
+    ToDevice(values_device, compensator_values);
+
+    if (statecentric_leapquant_smoothing_launch_v2(
+            stream, residual_device.data(), smoothing_device.data(), 0) == 0 ||
+        statecentric_leapquant_smoothing_launch_v2(
+            stream, residual_device.data(), smoothing_device.data(), 577) ==
+            0 ||
+        statecentric_leapquant_quantize_launch_v2(
+            stream, nullptr, smoothing_device.data(), quantized_device.data(),
+            scales_device.data(), kHeads) == 0) {
+      throw std::runtime_error("batched admission accepted invalid input");
+    }
+
+    auto smooth = [&] {
+      if (statecentric_leapquant_smoothing_launch_v2(
+              stream, residual_device.data(), smoothing_device.data(),
+              kHeads) != 0) {
+        throw std::runtime_error("batched smoothing admission failed");
+      }
+    };
+    auto quantize_only = [&] {
+      if (statecentric_leapquant_quantize_launch_v2(
+              stream, residual_device.data(), smoothing_device.data(),
+              quantized_device.data(), scales_device.data(), kHeads) != 0) {
+        throw std::runtime_error("batched quantize admission failed");
+      }
+    };
+    auto quantize = [&] {
+      smooth();
+      quantize_only();
+    };
+    auto copy_compressed = [&] {
+      Check(aclrtMemcpyAsync(quantized_copy.data(), quantized_copy.bytes(),
+                             quantized_device.data(), quantized_device.bytes(),
+                             ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
+            "copy quantized");
+      Check(aclrtMemcpyAsync(smoothing_copy.data(), smoothing_copy.bytes(),
+                             smoothing_device.data(),
+                             smoothing_device.bytes(),
+                             ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
+            "copy smoothing");
+      Check(aclrtMemcpyAsync(scales_copy.data(), scales_copy.bytes(),
+                             scales_device.data(), scales_device.bytes(),
+                             ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
+            "copy scales");
+      Check(aclrtMemcpyAsync(keys_copy.data(), keys_copy.bytes(),
+                             keys_device.data(), keys_device.bytes(),
+                             ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
+            "copy keys");
+      Check(aclrtMemcpyAsync(values_copy.data(), values_copy.bytes(),
+                             values_device.data(), values_device.bytes(),
+                             ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
+            "copy values");
+    };
+    auto dequantize = [&](const std::int8_t* quantized,
+                          const float* smoothing, const float* scales,
+                          const float* keys, const float* values) {
+      if (statecentric_leapquant_dequantize_launch_v2(
+              stream, quantized, smoothing, scales, keys, values,
+              dense_device.data(), kHeads) != 0) {
+        throw std::runtime_error("batched dequantize admission failed");
+      }
+    };
+    auto raw_copy = [&] {
+      Check(aclrtMemcpyAsync(raw_copy_device.data(), raw_copy_device.bytes(),
+                             residual_device.data(), residual_device.bytes(),
+                             ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
+            "copy raw");
+    };
+    auto pipeline = [&] {
+      quantize();
+      copy_compressed();
+      dequantize(quantized_copy.data(), smoothing_copy.data(),
+                 scales_copy.data(), keys_copy.data(), values_copy.data());
+    };
+
+    quantize();
+    dequantize(quantized_device.data(), smoothing_device.data(),
+               scales_device.data(), keys_device.data(), values_device.data());
+    Check(aclrtSynchronizeStream(stream), "sync exactness");
+
+    const auto quantized = FromDevice(quantized_device, kElements);
+    const auto smoothing = FromDevice(smoothing_device, kVectors);
+    const auto scales = FromDevice(scales_device, kVectors);
+    const auto dense = FromDevice(dense_device, kElements);
+    std::size_t quantized_mismatches = 0;
+    double squared_error = 0.0;
+    double squared_reference = 0.0;
+    float maximum_smoothing_error = 0.0F;
+    float maximum_scale_error = 0.0F;
+    double maximum_dense_error = 0.0;
+    std::size_t maximum_dense_error_index = 0;
+    float maximum_dense_error_actual = 0.0F;
+    float maximum_dense_error_expected = 0.0F;
+    for (std::size_t head = 0; head < kHeads; ++head) {
+      const auto head_elements = head * kElementsPerHead;
+      const auto head_vectors = head * kKeys;
+      const auto head_compensators = head * kCompensatorsPerHead;
+      for (std::size_t row = 0; row < kKeys; ++row) {
+        float sum = 0.0F;
+        for (std::size_t column = 0; column < kValues; ++column) {
+          sum += std::abs(residual[head_elements + row * kValues + column]);
+        }
+        const float expected = std::sqrt(std::max(sum / 128.0F, 1.0e-8F));
+        maximum_smoothing_error =
+            std::max(maximum_smoothing_error,
+                     std::abs(smoothing[head_vectors + row] - expected));
+      }
+      for (std::size_t column = 0; column < kValues; ++column) {
+        float maximum = 0.0F;
+        for (std::size_t row = 0; row < kKeys; ++row) {
+          maximum = std::max(
+              maximum,
+              std::abs(residual[head_elements + row * kValues + column] /
+                       smoothing[head_vectors + row]));
+        }
+        maximum_scale_error =
+            std::max(maximum_scale_error,
+                     std::abs(scales[head_vectors + column] - maximum));
+        for (std::size_t row = 0; row < kKeys; ++row) {
+          const float scaled =
+              maximum == 0.0F
+                  ? 0.0F
+                  : residual[head_elements + row * kValues + column] /
+                        smoothing[head_vectors + row] / maximum * 127.0F;
+          const auto expected = static_cast<std::int8_t>(
+              std::clamp(std::lround(scaled), -127L, 127L));
+          if (quantized[head_elements + row * kValues + column] != expected) {
+            ++quantized_mismatches;
+          }
+        }
+      }
+      for (std::size_t row = 0; row < kKeys; ++row) {
+        for (std::size_t column = 0; column < kValues; ++column) {
+          float expected = residual[head_elements + row * kValues + column];
+          for (std::size_t rank = 0; rank < kRank; ++rank) {
+            expected += compensator_keys
+                            [head_compensators + row * kRank + rank] *
+                        compensator_values
+                            [head_compensators + column * kRank + rank];
+          }
+          const double difference =
+              dense[head_elements + row * kValues + column] - expected;
+          if (std::abs(difference) > maximum_dense_error) {
+            maximum_dense_error = std::abs(difference);
+            maximum_dense_error_index = head_elements + row * kValues + column;
+            maximum_dense_error_actual =
+                dense[head_elements + row * kValues + column];
+            maximum_dense_error_expected = expected;
+          }
+          squared_error += difference * difference;
+          squared_reference += static_cast<double>(expected) * expected;
+        }
+      }
+    }
+    if (maximum_smoothing_error > 2.0e-5F ||
+        maximum_scale_error > 2.0e-5F || quantized_mismatches != 0) {
+      throw std::runtime_error(
+          "all-head exactness gate failed: smoothing_error=" +
+          std::to_string(maximum_smoothing_error) +
+          " scale_error=" + std::to_string(maximum_scale_error) +
+          " quantized_mismatches=" + std::to_string(quantized_mismatches));
+    }
+
+    for (int warmup = 0; warmup < 3; ++warmup) {
+      quantize();
+      copy_compressed();
+      dequantize(quantized_copy.data(), smoothing_copy.data(),
+                 scales_copy.data(), keys_copy.data(), values_copy.data());
+      raw_copy();
+    }
+    Check(aclrtSynchronizeStream(stream), "sync warmup");
+    std::vector<double> smoothing_us;
+    std::vector<double> quantize_only_us;
+    std::vector<double> quantize_us;
+    std::vector<double> compressed_copy_us;
+    std::vector<double> dequantize_us;
+    std::vector<double> raw_copy_us;
+    std::vector<double> pipeline_us;
+    for (int repeat = 0; repeat < 11; ++repeat) {
+      smoothing_us.push_back(Measure(stream, smooth));
+      quantize_only_us.push_back(Measure(stream, quantize_only));
+      quantize_us.push_back(Measure(stream, quantize));
+      compressed_copy_us.push_back(Measure(stream, copy_compressed));
+      dequantize_us.push_back(Measure(stream, [&] {
+        dequantize(quantized_copy.data(), smoothing_copy.data(),
+                   scales_copy.data(), keys_copy.data(), values_copy.data());
+      }));
+      raw_copy_us.push_back(Measure(stream, raw_copy));
+      pipeline_us.push_back(Measure(stream, pipeline));
+    }
+
+    residual_device.CheckGuard();
+    raw_copy_device.CheckGuard();
+    quantized_device.CheckGuard();
+    smoothing_device.CheckGuard();
+    scales_device.CheckGuard();
+    keys_device.CheckGuard();
+    values_device.CheckGuard();
+    dense_device.CheckGuard();
+    quantized_copy.CheckGuard();
+    smoothing_copy.CheckGuard();
+    scales_copy.CheckGuard();
+    keys_copy.CheckGuard();
+    values_copy.CheckGuard();
+
+    const auto compressed_bytes = quantized_copy.bytes() +
+                                  smoothing_copy.bytes() + scales_copy.bytes() +
+                                  keys_copy.bytes() + values_copy.bytes();
+    std::cout << "{\"device\":" << device << ",\"heads\":" << kHeads
+              << ",\"geometry\":\"576x128x128\""
+              << ",\"raw_bytes\":" << residual_device.bytes()
+              << ",\"compressed_fp32_compensator_bytes\":"
+              << compressed_bytes
+              << ",\"quantized_mismatches\":" << quantized_mismatches
+              << ",\"max_smoothing_error\":"
+              << maximum_smoothing_error
+              << ",\"max_scale_error\":" << maximum_scale_error
+              << ",\"relative_rms\":"
+              << std::sqrt(squared_error / squared_reference)
+              << ",\"maximum_dense_error\":" << maximum_dense_error
+              << ",\"maximum_dense_error_index\":"
+              << maximum_dense_error_index
+              << ",\"maximum_dense_error_actual\":"
+              << maximum_dense_error_actual
+              << ",\"maximum_dense_error_expected\":"
+              << maximum_dense_error_expected
+              << ",\"smoothing_median_us\":" << Median(smoothing_us)
+              << ",\"quantize_only_median_us\":"
+              << Median(quantize_only_us)
+              << ",\"quantize_median_us\":" << Median(quantize_us)
+              << ",\"compressed_copy_median_us\":"
+              << Median(compressed_copy_us)
+              << ",\"dequantize_median_us\":" << Median(dequantize_us)
+              << ",\"raw_copy_median_us\":" << Median(raw_copy_us)
+              << ",\"pipeline_median_us\":" << Median(pipeline_us)
+              << ",\"rank_fit_included\":false}\n";
+
+    Check(aclrtDestroyStream(stream), "aclrtDestroyStream");
+    stream = nullptr;
+    Check(aclrtResetDevice(device), "aclrtResetDevice");
+    device_set = false;
+    Check(aclFinalize(), "aclFinalize");
+    initialized = false;
+    return 0;
+  } catch (const std::exception& error) {
+    std::cerr << "LeapQuant all-head probe failed: " << error.what() << '\n';
+    if (stream != nullptr) (void)aclrtSynchronizeStream(stream);
+    if (stream != nullptr) (void)aclrtDestroyStream(stream);
+    if (device_set) (void)aclrtResetDevice(device);
+    if (initialized) (void)aclFinalize();
+    return 1;
+  }
+}
diff --git a/native/ascendc/leapquant_state_codec/kernel/leapquant_dequantize.cpp b/native/ascendc/leapquant_state_codec/kernel/leapquant_dequantize.cpp
index 02f27b41a..6199ff745 100644
--- a/native/ascendc/leapquant_state_codec/kernel/leapquant_dequantize.cpp
+++ b/native/ascendc/leapquant_state_codec/kernel/leapquant_dequantize.cpp
@@ -11,18 +11,29 @@ constexpr std::uint32_t kCompensatorElements = kKeys * kRank;
 
 class DequantizeKernel {
  public:
-  __aicore__ inline void Init(GM_ADDR quantized, GM_ADDR smoothing, GM_ADDR scales, GM_ADDR keys, GM_ADDR values, GM_ADDR dense) {
-    quantized_.SetGlobalBuffer(reinterpret_cast<__gm__ std::int8_t*>(quantized), kElements);
-    smoothing_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(smoothing), kKeys);
-    scales_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales), kValues);
-    keys_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(keys), kCompensatorElements);
-    values_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(values), kCompensatorElements);
-    dense_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dense), kElements);
+  __aicore__ inline void Init(GM_ADDR quantized, GM_ADDR smoothing,
+                              GM_ADDR scales, GM_ADDR keys, GM_ADDR values,
+                              GM_ADDR dense, std::uint32_t heads) {
+    heads_ = heads;
+    quantized_.SetGlobalBuffer(
+        reinterpret_cast<__gm__ std::int8_t*>(quantized), heads * kElements);
+    smoothing_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(smoothing),
+                               heads * kKeys);
+    scales_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales),
+                            heads * kValues);
+    keys_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(keys),
+                          heads * kCompensatorElements);
+    values_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(values),
+                            heads * kCompensatorElements);
+    dense_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dense),
+                           heads * kElements);
     pipe_.InitBuffer(quantized_buffer_, kValues * sizeof(std::int8_t));
-    pipe_.InitBuffer(smoothing_buffer_, 32);
+    pipe_.InitBuffer(smoothing_buffer_, kKeys * sizeof(float));
     pipe_.InitBuffer(scales_buffer_, kValues * sizeof(float));
-    pipe_.InitBuffer(keys_buffer_, 32);
