+extern "C" std::int32_t statecentric_leapquant_smoothing_launch_v2(
+    void* stream, const float* residual, float* smoothing,
+    uint32_t heads) {
+  if (stream == nullptr || residual == nullptr || smoothing == nullptr ||
+      heads == 0 || heads > 576) {
+    return 1;
+  }
+  statecentric_leapquant_smoothing<<<64, nullptr, stream>>>(
+      const_cast<float*>(residual), smoothing, heads);
   return 0;
 }
